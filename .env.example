# TSP Database — copy this to .env and fill in real values
TSP_DB_HOST=localhost
TSP_DB_PORT=5432
TSP_DB_USER=your_db_user
TSP_DB_PASSWORD=your_db_password
TSP_DB_NAME=training_solutions

# OpenRouter API key — get from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# LLM model — default is Gemma 4 E4B (recommended)
# Free tier:  google/gemma-4-e4b-it:free
# Paid tier:  google/gemma-4-e4b-it
GEMMA_MODEL=google/gemma-4-e4b-it:free

# Optional: Connection pool settings
TSP_DB_POOL_MIN=2
TSP_DB_POOL_MAX=10
